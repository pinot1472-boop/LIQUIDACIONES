# ===== Bot de Liquidez (servicio aparte en Railway) =====
TELEGRAM_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
TIMEFRAMES=5m,15m
CANDLES=500
MIN_VOLUME_USDT=1000000
CONCURRENCY=8
MARKET_TYPE=swap
EXCLUDE_NON_CRYPTO=true

# Zonas de liquidez
LQ_PIVOT=5
LQ_LOOKBACK=300
LQ_TOL_ATR=0.25
LQ_EXTREME_N=20
LQ_MIN_ZONE_SCORE=50

# Liquidaciones estimadas (modelo apalancamiento x volumen)
LQ_LEVERAGES=10,25,50,100
LQ_LEV_WEIGHTS=0.3,0.3,0.25,0.15
LQ_LONG_SHARE=0.6
LQ_LIQ_RANGE_PCT=10

# Setups y fuerza
LQ_ENABLE_SOUP=true
LQ_ENABLE_PLUS1=true
LQ_ENABLE_BOUNCE=true
LQ_MIN_SWEEP_ATR=0.05
LQ_MAX_SWEEP_ATR=3.0
LQ_VOL_MULT=1.5
LQ_MIN_WICK=0.35
LQ_MIN_QUALITY=65
LQ_USE_EMA_FILTER=false

# Gestion
LQ_SL_ATR_BUFFER=0.1
LQ_MIN_RR=1.5
LQ_DEFAULT_RR=2.0
LQ_MAX_RR=4.0
LQ_MAX_RISK_PCT=3.0
LQ_MAX_HOLD_BARS=48
LQ_COOLDOWN_BARS=6

# Resumen diario
REPORT_TZ=Europe/Madrid
REPORT_TIME=23:59
FEE_PCT_ROUNDTRIP=0.1

# Extras del indicador de TradingView (todos opcionales, true/false)
LQ_USE_UT=true
UT_ATR_PERIOD=10
UT_MULT=2
LQ_UT_REQUIRE=false
LQ_USE_LINREG=true
LINREG_LEN=11
LINREG_SIGNAL=7
LQ_USE_SR=true
LQ_USE_HTF=true
LQ_HTF_MIN_ALIGNED=0
LQ_SHOW_PANEL=true
